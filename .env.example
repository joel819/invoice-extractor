# Copy to .env and edit. Every variable is optional; defaults are shown.

APP_NAME=invoice-extractor
DATA_DIR=./data              # SQLite database lives here
DATABASE_URL=                # empty = sqlite in DATA_DIR
SEED_ON_STARTUP=true         # extract the sample invoices on startup
MAX_UPLOAD_MB=10
MAX_PAGES=20

# LLM (OpenAI-compatible API; Groq free tier by default).
# Leave GROQ_API_KEY empty to run in demo mode (rule-based extractor, no LLM).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45
LLM_REPAIR_ATTEMPTS=1        # re-ask the model once with the validation errors if its JSON is invalid

# Validation
LOW_CONFIDENCE_THRESHOLD=0.7
MONEY_TOLERANCE=0.02
